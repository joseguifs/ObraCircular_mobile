# Android Emulator: http://10.0.2.2:8000
# iOS Simulator e web: http://localhost:8000
# Dispositivo físico: use o IP da sua máquina na rede local.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Opcionais enquanto a autenticação ainda não estiver implementada.
# Sem eles, o app utiliza o primeiro usuário ativo e o primeiro endereço dele.
EXPO_PUBLIC_DEV_USUARIO_ID=
EXPO_PUBLIC_DEV_ENDERECO_ID=
