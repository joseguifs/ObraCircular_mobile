APP_NAME=Obra Circular API
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/obra_circular
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ADMIN_SESSAO_HORAS=8

# Mercado Pago - Pix com QR code (API de pagamentos)
# Os mesmos nomes com prefixo OBRA_CIRCULAR_ (ex.: OBRA_CIRCULAR_MP_ACCESS_TOKEN) do .env da web também são aceitos.
# Access token da conta recebedora da Obra Circular (precisa ter chave Pix cadastrada).
MP_ACCESS_TOKEN=
# Assinaturas secretas dos webhooks (painel do Mercado Pago > Suas integrações > Webhooks, evento Pagamentos).
MP_WEBHOOK_SECRET_TEST=
MP_WEBHOOK_SECRET_PRODUCTION=
MP_WEBHOOK_SECRET=
MP_LIVE_MODE=false
# URL pública HTTPS do backend para receber webhooks (em desenvolvimento, a URL do ngrok da porta 8000).
# Opcional: sem ela o Pix é gerado e a confirmação vem pelo botão "Já paguei, atualizar" do app.
MP_PUBLIC_BASE_URL=https://SEU_SUBDOMINIO.ngrok-free.app
# Opcional: padrão = MP_PUBLIC_BASE_URL + /api/v1/webhooks/mercado-pago
MP_WEBHOOK_URL=
# Somente com MP_LIVE_MODE=false: e-mail do pagador, diferente do e-mail da conta recebedora.
# Em produção fica vazio e cada comprador usa o próprio e-mail cadastrado no app.
MP_TEST_PAYER_EMAIL=
# Minutos em que o anúncio fica reservado e o QR code vale (mínimo efetivo de 31, exigência do Pix).
MP_CHECKOUT_MINUTES=31
# Percentual retido pela Obra Circular em cada venda antes do repasse ao vendedor (0 a 100).
MARKETPLACE_FEE_PERCENT=20
